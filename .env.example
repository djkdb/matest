# 큐넷(공공데이터포털) 국가기술자격 시험일정 API 연동 설정
#
# 1) https://www.data.go.kr 에서 "한국산업인력공단_국가기술자격 시험일정"
#    오픈API 활용신청 → 발급받은 "일반 인증키(Decoding)" 를 아래에 넣으세요.
# 2) 이 파일을 `.env.local` 로 복사한 뒤 값을 채우면 됩니다.
#    (VITE_ 접두사가 붙은 값만 브라우저에 노출됩니다.)
#
# 키가 없으면 앱은 각 시험의 예시 일정(scheduleFallback)을 사용합니다.

VITE_QNET_API_KEY=

# API 베이스 경로.
# - 개발: 기본값 '/api/qnet' → vite.config.js 프록시가 공공데이터포털로 전달
# - 배포: 동일 경로를 서버리스/리버스 프록시로 연결하거나, 전체 URL 지정
# VITE_QNET_BASE=/api/qnet
